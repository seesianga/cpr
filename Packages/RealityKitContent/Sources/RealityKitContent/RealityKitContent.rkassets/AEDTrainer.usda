#usda 1.0
(
    defaultPrim = "aed_trainer"
    documentation = "Original training-only AED and preparation props. No protected branding. Metres scale."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "aed_trainer"
{
    def Scope "Materials"
    {
        def Material "CaseCrimson"
        {
            token outputs:surface.connect = </aed_trainer/Materials/CaseCrimson/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.035, 0.065)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }
        def Material "UnitWhite"
        {
            token outputs:surface.connect = </aed_trainer/Materials/UnitWhite/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.89, 0.84)
                float inputs:metallic = 0.03
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
        def Material "ClinicalBlue"
        {
            token outputs:surface.connect = </aed_trainer/Materials/ClinicalBlue/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.34, 0.58)
                float inputs:metallic = 0.08
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }
        def Material "StatusGreen"
        {
            token outputs:surface.connect = </aed_trainer/Materials/StatusGreen/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.72, 0.4)
                color3f inputs:emissiveColor = (0.02, 0.16, 0.07)
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }
        def Material "PadGold"
        {
            token outputs:surface.connect = </aed_trainer/Materials/PadGold/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.72, 0.18)
                float inputs:metallic = 0.02
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
        def Material "Charcoal"
        {
            token outputs:surface.connect = </aed_trainer/Materials/Charcoal/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.075, 0.08, 0.09)
                float inputs:metallic = 0.16
                float inputs:roughness = 0.58
                token outputs:surface
            }
        }
    }

    def Xform "aed_case"
    {
        float3 xformOp:translate = (-0.38, 0.14, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "aed_case_shell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/CaseCrimson>
            double size = 1
            float3 xformOp:scale = (0.34, 0.22, 0.32)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
        def Cube "aed_case_handle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/Charcoal>
            double size = 1
            float3 xformOp:translate = (0, 0.15, 0)
            float3 xformOp:scale = (0.16, 0.045, 0.055)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "aed_unit"
    {
        float3 xformOp:translate = (0, 0.13, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "aed_unit_shell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/UnitWhite>
            double size = 1
            float3 xformOp:scale = (0.34, 0.20, 0.32)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
        def Xform "aed_power_button"
        {
            float3 xformOp:translate = (-0.09, 0.12, -0.055)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cylinder "aed_power_button_surface" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </aed_trainer/Materials/ClinicalBlue>
                uniform token axis = "Y"
                double height = 0.025
                double radius = 0.027
            }
        }
        def Xform "aed_status_light"
        {
            float3 xformOp:translate = (0.09, 0.12, -0.055)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Sphere "aed_status_light_surface" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </aed_trainer/Materials/StatusGreen>
                double radius = 0.024
                float3 xformOp:scale = (1, 0.55, 1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
        def Xform "aed_connector"
        {
            float3 xformOp:translate = (0.19, 0.02, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            def Cube "aed_connector_socket" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </aed_trainer/Materials/Charcoal>
                double size = 1
                float3 xformOp:scale = (0.05, 0.055, 0.08)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    # Both naming orders are retained as semantic aliases for authored-content contracts.
    def Xform "aed_left_pad"
    {
        float3 xformOp:translate = (0.32, 0.035, -0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "aed_pad_left" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/PadGold>
            double size = 1
            float3 xformOp:scale = (0.13, 0.018, 0.16)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Xform "aed_right_pad"
    {
        float3 xformOp:translate = (0.49, 0.035, -0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "aed_pad_right" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/PadGold>
            double size = 1
            float3 xformOp:scale = (0.13, 0.018, 0.16)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }

    def Cube "electrode_packet" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </aed_trainer/Materials/ClinicalBlue>
        double size = 1
        float3 xformOp:translate = (0.42, 0.035, 0.06)
        float3 xformOp:scale = (0.23, 0.025, 0.17)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "prep_cloth" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </aed_trainer/Materials/UnitWhite>
        double size = 1
        float3 xformOp:translate = (-0.42, 0.02, 0.25)
        float3 xformOp:scale = (0.18, 0.012, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "training_scissors"
    {
        float3 xformOp:translate = (-0.14, 0.035, 0.28)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "training_scissors_blade" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/Charcoal>
            double size = 1
            float3 xformOp:scale = (0.05, 0.018, 0.22)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
        def Capsule "training_scissors_handle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/CaseCrimson>
            uniform token axis = "Z"
            double height = 0.05
            double radius = 0.025
            float3 xformOp:translate = (0, 0, 0.12)
            float3 xformOp:scale = (1, 0.38, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Xform "training_razor"
    {
        float3 xformOp:translate = (0.05, 0.035, 0.29)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "training_razor_handle" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/ClinicalBlue>
            double size = 1
            float3 xformOp:scale = (0.045, 0.025, 0.15)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
        def Cube "training_razor_head" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/Charcoal>
            double size = 1
            float3 xformOp:translate = (0, 0, -0.085)
            float3 xformOp:scale = (0.10, 0.025, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
    def Xform "glove_box"
    {
        float3 xformOp:translate = (0.31, 0.075, 0.29)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "glove_box_shell" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </aed_trainer/Materials/UnitWhite>
            double size = 1
            float3 xformOp:scale = (0.22, 0.12, 0.15)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
}
