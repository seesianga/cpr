#usda 1.0
(
    defaultPrim = "DRSABCTrainingRoom"
    documentation = "Non-graphic DRSABC practice staging. Medical prompts are supplied by reviewed course content, not this geometry."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "DRSABCTrainingRoom"
{
    def Cylinder "practice_floor"
    {
        uniform token axis = "Y"
        double height = 0.025
        double radius = 1.65
        color3f[] primvars:displayColor = [(0.085, 0.095, 0.11)]
    }
    def Xform "anchor_safety_hazards"
    {
        float3 xformOp:translate = (-0.85, 0.44, -0.65)
        float xformOp:rotateX = -90
        float3 xformOp:scale = (0.85, 0.85, 0.85)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (0.95, 0, -0.70)
        float3 xformOp:scale = (0.88, 0.88, 0.88)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (0, 0, -0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
