#usda 1.0
(
    defaultPrim = "Scenario_Workplace"
    documentation = "Integrated workplace response training scenario. Non-graphic; simulated emergency call only."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario_Workplace"
{
    def Xform "anchor_capstone_environment"
    {
        float3 xformOp:translate = (0, 0, -2.30)
        float xformOp:rotateX = -90
        float xformOp:rotateY = 18
        float3 xformOp:scale = (5.2, 5.2, 5.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:rotateY", "xformOp:scale"]
    }
    def Xform "clear_zone" ( prepend references = @ClearZone.usda@ )
    {
        float3 xformOp:translate = (0.14, 0, -0.52)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (0.14, 0, -0.52)
        float xformOp:rotateY = -8
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    }
    def Xform "aed_trainer" ( prepend references = @AEDTrainer.usda@ )
    {
        float3 xformOp:translate = (0.82, 0, -0.30)
        float3 xformOp:scale = (0.72, 0.72, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (-0.92, 0, -0.92)
        float3 xformOp:scale = (0.86, 0.86, 0.86)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_02" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (1.20, 0, -1.12)
        float3 xformOp:scale = (0.80, 0.80, 0.80)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
