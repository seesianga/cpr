#usda 1.0
(
    defaultPrim = "Scenario_CommunityFacility"
    documentation = "Integrated community-facility response training scenario. Non-graphic; simulated emergency call only."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario_CommunityFacility"
{
    def Xform "anchor_theatre_environment"
    {
        float3 xformOp:translate = (0, 0, -2.30)
        float xformOp:rotateX = -90
        float xformOp:rotateY = -16
        float3 xformOp:scale = (5.5, 5.5, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:rotateY", "xformOp:scale"]
    }
    def Xform "clear_zone" ( prepend references = @ClearZone.usda@ )
    {
        float3 xformOp:translate = (-0.12, 0, -0.54)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (-0.12, 0, -0.54)
        float xformOp:rotateY = 7
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    }
    def Xform "aed_trainer" ( prepend references = @AEDTrainer.usda@ )
    {
        float3 xformOp:translate = (-0.82, 0, -0.24)
        float3 xformOp:scale = (0.72, 0.72, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (-1.12, 0, -1.10)
        float3 xformOp:scale = (0.84, 0.84, 0.84)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_02" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (1.08, 0, -0.96)
        float3 xformOp:scale = (0.88, 0.88, 0.88)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
