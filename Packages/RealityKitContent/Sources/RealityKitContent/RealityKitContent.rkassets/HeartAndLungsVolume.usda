#usda 1.0
(
    defaultPrim = "HeartAndLungsVolume"
    documentation = "Volumetric cardiopulmonary learning model."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "HeartAndLungsVolume"
{
    def Xform "anchor_practice_window_frame"
    {
        float3 xformOp:translate = (0, 0.34, 0.10)
        float xformOp:rotateX = -90
        float3 xformOp:scale = (0.72, 0.72, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
    }
    def Xform "cardiopulmonary_models" (
        prepend references = @HeartAndLungs.usda@
    )
    {
        float3 xformOp:translate = (0, -0.12, 0.02)
        float3 xformOp:scale = (1.15, 1.15, 1.15)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
