#usda 1.0
(
    defaultPrim = "Scenario_Home"
    documentation = "Integrated home-response training scenario. Non-graphic; simulated emergency call only."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario_Home"
{
    def "capstone_environment" ( prepend references = @Assets/capstone-environment.usdz@ )
    {
        float3 xformOp:translate = (0, 0, -2.15)
        float xformOp:rotateX = -90
        float3 xformOp:scale = (5.0, 5.0, 5.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
    }
    def Xform "clear_zone" ( prepend references = @ClearZone.usda@ )
    {
        float3 xformOp:translate = (0, 0, -0.48)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (0, 0, -0.48)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "aed_trainer" ( prepend references = @AEDTrainer.usda@ )
    {
        float3 xformOp:translate = (0.72, 0, -0.25)
        float3 xformOp:scale = (0.72, 0.72, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (-1.00, 0, -0.92)
        float3 xformOp:scale = (0.88, 0.88, 0.88)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_02" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (1.12, 0, -1.12)
        float3 xformOp:scale = (0.82, 0.82, 0.82)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
