#usda 1.0
(
    defaultPrim = "Scenario_ShoppingCentre"
    documentation = "Integrated shopping-centre response training scenario. Non-graphic; simulated emergency call only."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Scenario_ShoppingCentre"
{
    def "theatre_environment" ( prepend references = @Assets/theatre-environment.usdz@ )
    {
        float3 xformOp:translate = (0, 0, -2.35)
        float xformOp:rotateX = -90
        float3 xformOp:scale = (5.5, 5.5, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:scale"]
    }
    def Xform "clear_zone" ( prepend references = @ClearZone.usda@ )
    {
        float3 xformOp:translate = (0, 0, -0.52)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (0, 0, -0.52)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "aed_trainer" ( prepend references = @AEDTrainer.usda@ )
    {
        float3 xformOp:translate = (-0.76, 0, -0.20)
        float3 xformOp:scale = (0.70, 0.70, 0.70)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (-1.10, 0, -1.05)
        float3 xformOp:scale = (0.88, 0.88, 0.88)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_02" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (1.05, 0, -1.10)
        float3 xformOp:scale = (0.84, 0.84, 0.84)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
