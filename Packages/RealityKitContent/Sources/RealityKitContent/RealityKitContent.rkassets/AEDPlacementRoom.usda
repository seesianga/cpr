#usda 1.0
(
    defaultPrim = "AEDPlacementRoom"
    documentation = "AED pad-placement practice. Pad-zone meaning follows reviewed course content."
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "AEDPlacementRoom"
{
    def Cylinder "practice_floor"
    {
        uniform token axis = "Y"
        double height = 0.025
        double radius = 1.55
        color3f[] primvars:displayColor = [(0.075, 0.085, 0.10)]
    }
    def Xform "clear_zone" ( prepend references = @ClearZone.usda@ ) { }
    def Xform "training_manikin" ( prepend references = @TrainingManikin.usda@ )
    {
        float3 xformOp:translate = (-0.18, 0, -0.58)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "aed_trainer" ( prepend references = @AEDTrainer.usda@ )
    {
        float3 xformOp:translate = (0.58, 0, -0.20)
        float3 xformOp:scale = (0.72, 0.72, 0.72)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "bystander_01" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (-0.92, 0, 0.24)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "bystander_02" ( prepend references = @Bystander.usda@ )
    {
        float3 xformOp:translate = (0.92, 0, 0.24)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
